# Runs at install time: finds the MSYS2 package of every bundled DLL, copies each package's
# license files to licenses/<package>/ and writes THIRD-PARTY-NOTICES.txt. The fixed wording is
# in docs/delivery/THIRD-PARTY-NOTICES.txt.in and THIRD-PARTY-NOTICES-com0com.txt.
# Inputs: DESTINATION (install root), MSYS_ROOT (e.g. C:/msys64), COM0COM (ON/OFF).
# Install scripts set no policies: CMake 3.x would read IN_LIST the old way.
cmake_policy(VERSION 3.25)
# The MSYS2 shells set LANG (e.g. zh_TW.UTF-8) and pacman then answers in that language;
# the parsing below reads pacman's English output.
set(ENV{LC_ALL} C)
set(pacman "${MSYS_ROOT}/usr/bin/pacman.exe")
if(NOT EXISTS "${pacman}")
  message(FATAL_ERROR "pacman not found at ${pacman}; third-party notices need the MSYS2 package database")
endif()
set(prefix "mingw-w64-ucrt-x86_64-")
file(GLOB dlls RELATIVE "${DESTINATION}" "${DESTINATION}/*.dll")
list(SORT dlls)
list(LENGTH dlls dll_count)
if(dll_count EQUAL 0)
  message(FATAL_ERROR "No DLLs in ${DESTINATION}; runtime deployment must run first")
endif()
message(STATUS "Third-party notices: looking up ${dll_count} DLLs in the MSYS2 package database")
# One pacman call per question: starting pacman costs about a second on Windows, and one call
# per DLL and package took minutes. Only the needed lines are parsed: package descriptions may
# hold [ or ;, which would break a CMake list of whole lines.
set(paths "")
foreach(dll IN LISTS dlls)
  list(APPEND paths "${MSYS_ROOT}/ucrt64/bin/${dll}")
endforeach()
execute_process(COMMAND "${pacman}" -Qo ${paths} OUTPUT_VARIABLE owners ERROR_VARIABLE problem RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "pacman could not name the package of every DLL; their licenses cannot be recorded:\n${problem}")
endif()
string(REGEX MATCHALL "/ucrt64/bin/[^ \n]+ is owned by [^ \n]+" owners "${owners}")
set(packages "")
set(owned "")
foreach(line IN LISTS owners)
  string(REGEX MATCH "^/ucrt64/bin/([^ ]+) is owned by (.+)$" _ "${line}")
  string(MAKE_C_IDENTIFIER "${CMAKE_MATCH_2}" key)
  list(APPEND dlls_${key} "${CMAKE_MATCH_1}")
  list(APPEND packages "${CMAKE_MATCH_2}")
  list(APPEND owned "${CMAKE_MATCH_1}")
endforeach()
foreach(dll IN LISTS dlls)
  if(NOT dll IN_LIST owned)
    message(FATAL_ERROR "No MSYS2 package owns ${dll}; its license cannot be recorded")
  endif()
endforeach()
list(REMOVE_DUPLICATES packages)
list(SORT packages)
execute_process(COMMAND "${pacman}" -Qi ${packages} OUTPUT_VARIABLE info RESULT_VARIABLE result ERROR_VARIABLE problem)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "pacman -Qi failed:\n${problem}")
endif()
# Each package's block starts with its Name; the fields after it belong to that package.
string(REGEX MATCHALL "(Name|Version|Licenses|URL) +: [^\r\n]*" fields "${info}")
foreach(field IN LISTS fields)
  string(REGEX MATCH "^([A-Za-z]+) +: (.*)$" _ "${field}")
  set(field_name "${CMAKE_MATCH_1}")
  set(value "${CMAKE_MATCH_2}")
  if(field_name STREQUAL "Name")
    string(MAKE_C_IDENTIFIER "${value}" key)
  elseif(field_name STREQUAL "Version")
    set(version_${key} "${value}")
  elseif(field_name STREQUAL "Licenses")
    set(licenses_${key} "${value}")
  elseif(field_name STREQUAL "URL")
    set(url_${key} "${value}")
  endif()
endforeach()
execute_process(COMMAND "${pacman}" -Ql ${packages} OUTPUT_VARIABLE listing RESULT_VARIABLE result ERROR_VARIABLE problem)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "pacman -Ql failed:\n${problem}")
endif()
# The license files each package itself installs under share/licenses.
string(REGEX MATCHALL "[^ \n]+ /ucrt64/share/licenses/[^\r\n]*" license_files "${listing}")
foreach(line IN LISTS license_files)
  if(line MATCHES "/$")  # a directory
    continue()
  endif()
  string(REGEX MATCH "^([^ ]+) (.+)$" _ "${line}")
  string(MAKE_C_IDENTIFIER "${CMAKE_MATCH_1}" key)
  list(APPEND files_${key} "${CMAKE_MATCH_2}")
endforeach()

set(text "")
foreach(package IN LISTS packages)
  string(MAKE_C_IDENTIFIER "${package}" key)
  string(REPLACE "${prefix}" "" short "${package}")
  set(version "${version_${key}}")
  set(licenses "${licenses_${key}}")
  set(url "${url_${key}}")
  if(version STREQUAL "" OR licenses STREQUAL "")
    message(FATAL_ERROR "pacman gave no version or license for ${package}")
  endif()
  set(copied "")
  foreach(path IN LISTS files_${key})
    file(COPY "${MSYS_ROOT}${path}" DESTINATION "${DESTINATION}/licenses/${short}")
    get_filename_component(name "${path}" NAME)
    list(APPEND copied "${name}")
  endforeach()
  list(JOIN dlls_${key} ", " used)
  string(APPEND text "${short} ${version}\n")
  string(APPEND text "  DLL：${used}\n")
  string(APPEND text "  授權：${licenses}\n")
  if(copied)
    list(JOIN copied ", " copied)
    string(APPEND text "  授權全文：licenses\\${short}\\（${copied}）\n")
  elseif(licenses MATCHES "LGPL-2\\.1")
    # The package ships no license file; use the standard LGPL 2.1 text.
    file(GLOB lgpl "${MSYS_ROOT}/ucrt64/share/licenses/*/COPYING-LGPL-2.1" "${MSYS_ROOT}/ucrt64/share/licenses/*/COPYING.LGPLv2.1")
    if(NOT lgpl)
      message(FATAL_ERROR "${short} is LGPL-2.1 but no LGPL 2.1 text was found to ship with it")
    endif()
    list(GET lgpl 0 lgpl)
    configure_file("${lgpl}" "${DESTINATION}/licenses/common/LGPL-2.1.txt" COPYONLY)
    string(APPEND text "  授權全文：licenses\\common\\LGPL-2.1.txt（套件本身未附檔案）\n")
  else()
    message(FATAL_ERROR "${short} (${licenses}) ships no license file; add its text before packaging")
  endif()
  string(APPEND text "  網站：${url}\n")
  string(APPEND text "  原始碼：https://packages.msys2.org/package/${package}\n\n")
endforeach()
set(delivery "${CMAKE_CURRENT_LIST_DIR}/../docs/delivery")
set(PACKAGE_NOTICES "${text}")
set(COM0COM_NOTICE "")
if(COM0COM)
  file(READ "${delivery}/THIRD-PARTY-NOTICES-com0com.txt" COM0COM_NOTICE)
  string(REGEX REPLACE "\r?\n$" "" COM0COM_NOTICE "${COM0COM_NOTICE}")  # the template ends the line
endif()
file(READ "${delivery}/THIRD-PARTY-NOTICES.txt.in" template)
string(CONFIGURE "${template}" notices @ONLY)
# Git may check the texts out with CRLF; file(WRITE) turns every line break into CRLF on Windows.
string(REPLACE "\r" "" notices "${notices}")
file(WRITE "${DESTINATION}/THIRD-PARTY-NOTICES.txt" "${notices}")
list(LENGTH packages count)
message(STATUS "Third-party notices: ${count} MSYS2 packages")
