# Runs at install time: finds the MSYS2 package of every bundled DLL, copies each package's
# license files to licenses/<package>/ and writes THIRD-PARTY-NOTICES.txt.
# Inputs: DESTINATION (install root), MSYS_ROOT (e.g. C:/msys64), COM0COM (ON/OFF).
set(pacman "${MSYS_ROOT}/usr/bin/pacman.exe")
if(NOT EXISTS "${pacman}")
  message(FATAL_ERROR "pacman not found at ${pacman}; third-party notices need the MSYS2 package database")
endif()
set(prefix "mingw-w64-ucrt-x86_64-")
file(GLOB dlls RELATIVE "${DESTINATION}" "${DESTINATION}/*.dll")
list(SORT dlls)
set(packages "")
foreach(dll IN LISTS dlls)
  execute_process(COMMAND "${pacman}" -Qqo "${MSYS_ROOT}/ucrt64/bin/${dll}"
    OUTPUT_VARIABLE package RESULT_VARIABLE result OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT result EQUAL 0 OR package STREQUAL "")
    message(FATAL_ERROR "No MSYS2 package owns ${dll}; its license cannot be recorded")
  endif()
  string(MAKE_C_IDENTIFIER "${package}" key)
  list(APPEND dlls_${key} "${dll}")
  list(APPEND packages "${package}")
endforeach()
list(REMOVE_DUPLICATES packages)
list(SORT packages)

set(text "POSMV-Sweep 第三方元件授權說明\n")
string(APPEND text "================================\n\n")
string(APPEND text "本套件附帶下列以 MSYS2 UCRT64 建置的開放原始碼函式庫（動態連結的 DLL）。\n")
string(APPEND text "各套件的授權全文在 licenses\\<套件名稱>\\。\n")
string(APPEND text "原始碼與建置腳本：https://packages.msys2.org/package/<完整套件名稱>\n")
string(APPEND text "（頁面連到上游原始碼與 MSYS2 的建置腳本 https://github.com/msys2/MINGW-packages）。\n")
string(APPEND text "LGPL 函式庫以 DLL 形式提供，可以自行替換成相容的版本。\n\n")
foreach(package IN LISTS packages)
  string(MAKE_C_IDENTIFIER "${package}" key)
  string(REPLACE "${prefix}" "" short "${package}")
  execute_process(COMMAND "${pacman}" -Qi "${package}" OUTPUT_VARIABLE info ERROR_QUIET)
  string(REGEX MATCH "Version[ ]*: ([^\r\n]*)" _ "${info}")
  set(version "${CMAKE_MATCH_1}")
  string(REGEX MATCH "Licenses[ ]*: ([^\r\n]*)" _ "${info}")
  set(licenses "${CMAKE_MATCH_1}")
  string(REGEX MATCH "URL[ ]*: ([^\r\n]*)" _ "${info}")
  set(url "${CMAKE_MATCH_1}")
  # Copy the license files the package itself installs under share/licenses.
  execute_process(COMMAND "${pacman}" -Qlq "${package}" OUTPUT_VARIABLE owned ERROR_QUIET)
  string(REPLACE "\n" ";" owned "${owned}")
  set(copied "")
  foreach(path IN LISTS owned)
    if(path MATCHES "^/ucrt64/share/licenses/.*[^/]$")
      file(COPY "${MSYS_ROOT}${path}" DESTINATION "${DESTINATION}/licenses/${short}")
      get_filename_component(name "${path}" NAME)
      list(APPEND copied "${name}")
    endif()
  endforeach()
  list(JOIN dlls_${key} ", " used)
  string(APPEND text "${short} ${version}\n")
  string(APPEND text "  DLL：${used}\n")
  string(APPEND text "  授權：${licenses}\n")
  if(copied)
    list(JOIN copied ", " copied)
    string(APPEND text "  授權全文：licenses\\${short}\\（${copied}）\n")
  elseif(licenses MATCHES "LGPL-2\\.1")
    # The package ships no license file; use the standard LGPL 2.1 text.
    file(GLOB lgpl "${MSYS_ROOT}/ucrt64/share/licenses/*/COPYING-LGPL-2.1" "${MSYS_ROOT}/ucrt64/share/licenses/*/COPYING.LGPLv2.1")
    if(NOT lgpl)
      message(FATAL_ERROR "${short} is LGPL-2.1 but no LGPL 2.1 text was found to ship with it")
    endif()
    list(GET lgpl 0 lgpl)
    configure_file("${lgpl}" "${DESTINATION}/licenses/common/LGPL-2.1.txt" COPYONLY)
    string(APPEND text "  授權全文：licenses\\common\\LGPL-2.1.txt（套件本身未附檔案）\n")
  else()
    message(FATAL_ERROR "${short} (${licenses}) ships no license file; add its text before packaging")
  endif()
  string(APPEND text "  網站：${url}\n")
  string(APPEND text "  原始碼：https://packages.msys2.org/package/${package}\n\n")
endforeach()
if(COM0COM)
  string(APPEND text "com0com 2.2.2.0（虛擬 COM 驅動，只有 Simulator 的測試環境使用）\n")
  string(APPEND text "  檔案：drivers\\com0com-2.2.2.0-x64-fre-signed.zip（官方簽章版，未修改）\n")
  string(APPEND text "  授權：GNU GPL v2 或更新版本，全文 licenses\\com0com\\license.txt\n")
  string(APPEND text "  原始碼：drivers\\source\\com0com-2.2.2.0.zip（官方原始碼，未修改）\n")
  string(APPEND text "  網站：https://sourceforge.net/projects/com0com/\n")
  string(APPEND text "  com0com 是獨立程式，由 Simulator 在使用者同意（UAC）後另外安裝，不與本程式連結。\n")
endif()
file(WRITE "${DESTINATION}/THIRD-PARTY-NOTICES.txt" "${text}")
list(LENGTH packages count)
message(STATUS "Third-party notices: ${count} MSYS2 packages")
