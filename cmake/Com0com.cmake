# Runs at install time: places the pinned com0com 2.2.2.0 installer, its official source and its
# license in the package. Files are downloaded once into DOWNLOAD_CACHE and always checked by SHA-256.
# Inputs: DESTINATION, DOWNLOAD_CACHE.
set(base "https://downloads.sourceforge.net/project/com0com/com0com/2.2.2.0")
set(installer "com0com-2.2.2.0-x64-fre-signed.zip")
set(installer_sha256 "3bc7313e8577774ce78cff4d1c816faf96cfa48c485bbcc5527d4569f7d5e373")
set(source "com0com-2.2.2.0.zip")
set(source_sha256 "0dd767a0b9949c380ce513e91d82b71211b0c9e10a82a30181ae786d472ee766")
function(fetch name sha256)
  set(file "${DOWNLOAD_CACHE}/${name}")
  if(EXISTS "${file}")
    file(SHA256 "${file}" actual)
    if(actual STREQUAL sha256)
      return()
    endif()
    file(REMOVE "${file}")
  endif()
  message(STATUS "Downloading ${name}")
  file(DOWNLOAD "${base}/${name}" "${file}" EXPECTED_HASH SHA256=${sha256} STATUS status TLS_VERIFY ON)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Cannot download ${name}: ${status}. Put the file in ${DOWNLOAD_CACHE} to package offline.")
  endif()
endfunction()
fetch("${installer}" "${installer_sha256}")
fetch("${source}" "${source_sha256}")
file(COPY "${DOWNLOAD_CACHE}/${installer}" DESTINATION "${DESTINATION}/drivers")
file(COPY "${DOWNLOAD_CACHE}/${source}" DESTINATION "${DESTINATION}/drivers/source")
file(ARCHIVE_EXTRACT INPUT "${DOWNLOAD_CACHE}/${source}" DESTINATION "${DOWNLOAD_CACHE}/source" PATTERNS "com0com-2.2.2.0/license.txt")
file(COPY "${DOWNLOAD_CACHE}/source/com0com-2.2.2.0/license.txt" DESTINATION "${DESTINATION}/licenses/com0com")
