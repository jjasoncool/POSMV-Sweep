# Recursively deploy only DLLs available in this compiler's bin directory.
# Windows system DLLs remain supplied by the operating system.
# Run with -P, where no project sets policies: CMake 3.x would read IN_LIST the old way.
cmake_policy(VERSION 3.25)
if(NOT EXISTS "${APP}")
  message(FATAL_ERROR "Missing runtime deployment input: ${APP}")
endif()
set(queue "${APP}")
set(visited "")
while(queue)
  list(POP_FRONT queue binary)
  execute_process(COMMAND "${OBJDUMP}" -p "${binary}"
    OUTPUT_VARIABLE imports RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect runtime dependencies: ${binary}")
  endif()
  string(REGEX MATCHALL "DLL Name: [^\r\n]+" entries "${imports}")
  foreach(entry IN LISTS entries)
    string(REPLACE "DLL Name: " "" dll "${entry}")
    string(STRIP "${dll}" dll)
    if(dll IN_LIST visited)
      continue()
    endif()
    list(APPEND visited "${dll}")
    if(EXISTS "${RUNTIME_DIR}/${dll}")
      file(COPY "${RUNTIME_DIR}/${dll}" DESTINATION "${DESTINATION}")
      list(APPEND queue "${RUNTIME_DIR}/${dll}")
    endif()
  endforeach()
endwhile()