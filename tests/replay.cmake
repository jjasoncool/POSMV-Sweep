set(input "${BINARY}/replay-input.txt")
set(output "${BINARY}/replay-output.txt")
execute_process(COMMAND "${FIXTURE}" --fixture "${input}" RESULT_VARIABLE generated)
if(NOT generated EQUAL 0)
  message(FATAL_ERROR "Fixture generation failed")
endif()
execute_process(COMMAND "${APP}" --replay "${input}" --output "${output}" --off RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Replay failed")
endif()
file(READ "${input}" original HEX)
file(READ "${output}" transformed HEX)
if(NOT original STREQUAL transformed)
  message(FATAL_ERROR "OFF did not preserve bytes")
endif()
execute_process(COMMAND "${APP}" --replay "${input}" --output "${input}" RESULT_VARIABLE result)
if(result EQUAL 0)
  message(FATAL_ERROR "Accepted destructive same-file output")
endif()
execute_process(COMMAND "${APP}" --replay "${input}" --output "${output}" --cycle 0 RESULT_VARIABLE result)
if(result EQUAL 0)
  message(FATAL_ERROR "Accepted invalid cycle")
endif()