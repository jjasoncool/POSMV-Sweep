function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Command failed: ${ARGV}")
  endif()
endfunction()
set(input "${BINARY}/sim-test.txt")
execute_process(COMMAND "${SIM}" --debug --help OUTPUT_VARIABLE help ERROR_VARIABLE debug RESULT_VARIABLE code)
if(NOT code EQUAL 0 OR NOT help MATCHES "posmv-simulator" OR NOT debug MATCHES "Debug console enabled")
  message(FATAL_ERROR "GUI-subsystem CLI redirection/debug regression")
endif()
set(output "${BINARY}/sim-pass.txt")
run("${SIM}" --output "${input}" --count 101 --rate 25 --sine-roll --unpaced)
run("${APP}" --replay "${input}" --output "${output}" --off)
file(SIZE "${input}" size)
if(NOT size EQUAL 2727)
  message(FATAL_ERROR "Unexpected simulator frame width/count")
endif()
file(READ "${input}" bytes HEX)
file(READ "${output}" passed HEX)
if(NOT bytes STREQUAL passed)
  message(FATAL_ERROR "Simulator frames did not survive parser/pass-through")
endif()
run("${SIM}" --replay "${input}" --output "${output}" --unpaced)
run("${SIM}" validate --input "${input}")
file(READ "${output}" passed HEX)
if(NOT bytes STREQUAL passed)
  message(FATAL_ERROR "Simulator replay changed frames")
endif()
execute_process(COMMAND "${SIM}" --port COM10 --baud 9600 --rate 100 RESULT_VARIABLE result)
if(result EQUAL 0)
  message(FATAL_ERROR "Insufficient serial throughput accepted")
endif()
run("${SIM}" --output "${output}" --count 3 --rate 100 --roll -1.29)
run("${SIM}" --output "${output}" --count 3 --rate 200 --roll -1.29)
execute_process(COMMAND "${SIM}" --port COM10 --baud 38400 --rate 200 RESULT_VARIABLE result)
if(result EQUAL 0)
  message(FATAL_ERROR "200 Hz accepted at 38400 baud")
endif()
run("${SIM}" send --replay "${input}" --output "${output}" --loop --count 202 --unpaced)
file(SIZE "${output}" loop_size)
if(NOT loop_size EQUAL 5454)
  message(FATAL_ERROR "Loop replay frame count incorrect")
endif()
run("${SIM}" validate --input "${output}")
file(WRITE "${BINARY}/invalid-test.txt" "garbage")
execute_process(COMMAND "${SIM}" validate --input "${BINARY}/invalid-test.txt" RESULT_VARIABLE result)
if(NOT result EQUAL 2)
  message(FATAL_ERROR "Validator did not reject garbage")
endif()